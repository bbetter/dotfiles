[Unit]
Description=snappy-switcher Alt+Tab daemon
# The packaged unit points at /usr/local/bin and WAYLAND_DISPLAY=wayland-0.
PartOf=hyprland-session.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/bin/snappy-switcher --daemon
Restart=on-failure
RestartSec=1
