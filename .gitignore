# Temporary files
*~
*.swp
*.tmp
.DS_Store

# Logs
*.log

# Sensitive data
**/secrets*
**/*secret*
**/*password*
**/*token*

# Cache
**/.cache/

# History files
**/*history*
**/.*_history

# Backup directories
config-backup*/

# ---------------------------------------------------------------------------
# Generated by the wallpaper theme pipeline (scripts/.config/scripts/gen-theme.sh).
# Regenerated from *.template.* on every wallpaper change — track the templates,
# not these outputs, so the working tree stays clean and auto-commits stay quiet.
# Restore any of these on a fresh machine with:  ~/.config/scripts/apply-theme.sh
# ---------------------------------------------------------------------------
ags/.config/ags/style.scss
ags/.config/ags/.style.css
scripts/.config/theme/hyprland-colors.lua
ghostty/.config/ghostty/theme-wal
swaync/.config/swaync/style.css
swaylock/.config/swaylock/config
hypr/.config/hypr/hyprlock.conf
scripts/.config/fastfetch/config.jsonc
