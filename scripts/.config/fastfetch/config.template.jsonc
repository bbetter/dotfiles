// Themed by ~/.config/scripts/gen-theme.sh from the wal palette.
// Edit this template, not config.jsonc.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "__PRIMARY_ANSI__",
      "title": "__SECONDARY_ANSI__"
    },
    "percent": { "type": ["bar", "num"] },
    "bar": {
      "char": { "elapsed": "█", "total": "░" },
      "border": { "left": "", "right": " " },
      "width": 10
    }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "separator", "string": "─" },
    { "type": "os", "key": "  " },
    { "type": "kernel", "key": "  " },
    { "type": "packages", "key": "󰏖  " },
    { "type": "shell", "key": "  " },
    { "type": "wm", "key": "  " },
    { "type": "terminal", "key": "  " },
    { "type": "font", "key": "  " },
    "break",
    { "type": "cpu", "key": "󰻠  ", "showPeCoreCount": true },
    { "type": "gpu", "key": "󰢮  ", "driverSpecific": true },
    { "type": "memory", "key": "󰍛  " },
    { "type": "swap", "key": "󰓡  " },
    { "type": "disk", "key": "󰋊  " },
    { "type": "display", "key": "󰍹  " },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
