# Generated by ~/.config/scripts/gen-theme.sh from the wal palette.
# Edit this template, not ~/.local/share/vicinae/themes/wal.toml.
# Unset keys inherit from vicinae-dark.

[meta]
name = "wal"
description = "Generated from the wallpaper palette"
variant = "dark"
inherits = "vicinae-dark"

[colors.core]
accent = "__PRIMARY__"
accent_foreground = "#__BG__"
background = "#__BG__"
foreground = "__FG_CSS__"
secondary_background = "#__BG__"
border = "__PRIMARY__"

[colors.accents]
blue = "__SUCCESS__"
green = "__SPECIAL__"
magenta = "__PRIMARY__"
orange = "__SECONDARY__"
purple = "__PRIMARY__"
red = "__ERROR__"
yellow = "__SECONDARY__"
cyan = "__SUCCESS__"

[colors.text]
danger = "__ERROR__"
success = "__SPECIAL__"
selection = { background = "__PRIMARY__", foreground = "#ffffff" }

[colors.input]
border_focus = "__PRIMARY__"
border_error = "__ERROR__"

[colors.loading]
bar = "__PRIMARY__"
spinner = "__FG_CSS__"

# List hover/selection. vicinae-dark derives these from the border colour at very low
# opacity (0.10 / 0.15), which is barely distinguishable on the dark background.
[colors.list.item.hover]
background = { name = "colors.core.accent", opacity = 0.35 }

[colors.list.item.selection]
background = { name = "colors.core.accent", opacity = 0.55 }
