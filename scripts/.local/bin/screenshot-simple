#!/bin/bash

SAVE_DIR=~/Картинки/Screenshots
mkdir -p "$SAVE_DIR"

case "$1" in
    area-clip)
        grim -g "$(slurp)" - | wl-copy
        notify-send "📋 Screenshot" "Area copied to clipboard"
        ;;
    area-file)
        FILE="$SAVE_DIR/$(date +'screenshot_%Y-%m-%d_%H-%M-%S.png')"
        grim -g "$(slurp)" "$FILE"
        notify-send "💾 Screenshot" "Saved to:\n$FILE"
        ;;
    area-edit)
        grim -g "$(slurp)" - | satty -f - \
            --copy-command wl-copy --early-exit \
            --output-filename "$SAVE_DIR/$(date +'satty_%Y-%m-%d_%H-%M-%S.png')" \
            --actions-on-enter save-to-clipboard exit \
            --initial-tool arrow
        ;;
    full-clip)
        grim - | wl-copy
        notify-send "📋 Screenshot" "Screen copied to clipboard"
        ;;
    full-file)
        FILE="$SAVE_DIR/$(date +'screenshot_%Y-%m-%d_%H-%M-%S.png')"
        grim "$FILE"
        notify-send "💾 Screenshot" "Saved to:\n$FILE"
        ;;
esac
