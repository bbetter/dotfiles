# Generated by ~/.config/scripts/gen-theme.sh from the wal palette, then
# synced to /etc/ly/config.ini by ~/.local/bin/sync-ly-theme (via a narrow
# NOPASSWD sudoers rule). Edit this template, not /etc/ly/config.ini — it
# gets overwritten on the next theme change.
#
# Goal: make the pre-login (ly) and lock (hyprlock) screens read as the same
# system instead of two unrelated programs — same palette, no fire animation,
# a big centered clock instead of hyprlock's 92px one, minimal chrome.

# Doom fire off — calm look, matches hyprlock's plain blurred background.
animation = none

# Big ASCII clock instead of the small corner one — echoes hyprlock's large
# centered clock label.
bigclock = en
bigclock_12hr = false
bigclock_seconds = false
clock = null

lang = en
save = true
waylandsessions = /usr/share/wayland-sessions

# Colors — same wal palette as swaylock/hyprlock (bg/fg/ring/fail).
bg = 0x00__BG__
fg = 0x00__FG__
border_fg = 0x00__PRIMARY_HEX__
error_fg = 0x01__ERROR_HEX__

# Less chrome — closer to hyprlock's bare clock + password field.
hide_borders = true
hide_key_hints = true
hide_version_string = true
blank_box = false
